# Vercel Blob Store: web-course-2026-blob
# Значение выдаёт Vercel при подключении store к проекту.
BLOB_READ_WRITE_TOKEN=

# Необязательно: public или private. Если не задано, режим доступа
# определяется автоматически по URL store / ответу API.
# BLOB_ACCESS=private

# Необязательно: id store при использовании OIDC вместо read-write токена.
# BLOB_STORE_ID=
